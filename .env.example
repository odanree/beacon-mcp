# Beacon API base URL — your deployed beacon instance.
# Example: https://beacon.your-domain.com
BEACON_API_URL=

# JWT for Beacon. Easiest: log in at your beacon instance in the browser,
# open DevTools -> Application -> Cookies, copy the access_token value.
# These expire — re-grab when you get 401s.
BEACON_JWT=

# Optional: enables the `beacon_refresh_chatbot_rag` tool.
# Path to a local checkout of your ai-chatbot repo. The tool shells out
# to `npm run build:knowledge` in that directory and pushes commits, so
# git remote credentials must be usable from that checkout too (either
# via `gh auth login` or a stored credential helper).
AI_CHATBOT_PATH=

# Required if AI_CHATBOT_PATH is set — the embedding build script uses
# this for text-embedding-3-small calls (~$0.0002 per rebuild).
OPENAI_API_KEY=

LOG_LEVEL=INFO
