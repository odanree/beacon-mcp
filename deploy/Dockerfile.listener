# Container image for the beacon-mcp CDC listener, deployed on AWS Fargate
# per ADR-021 phase 3. See deploy/entrypoint-listener.sh for the runtime
# story.
#
# Build:
#   docker build -f deploy/Dockerfile.listener -t beacon-mcp-listener:local .
# Run (locally, for smoke test — needs SSH_PRIVATE_KEY + BEACON_DATABASE_URL
# + VERCEL_DEPLOY_HOOK_URL + RAG_REFRESH_MODE=webhook in the env):
#   docker run --rm -e SSH_PRIVATE_KEY -e BEACON_DATABASE_URL ... beacon-mcp-listener:local
#
# The final image weighs ~120–150 MB — Python + asyncpg + httpx + autossh.

FROM python:3.11-slim AS base

# System deps:
#   autossh          — resilient SSH tunnel to Hetzner Beacon Postgres
#   openssh-client   — the ssh binary autossh delegates to
#   ca-certificates  — trust roots for HTTPS calls to Vercel Deploy Hook
#   tini             — proper PID 1 (reaps zombies from autossh)
RUN apt-get update && apt-get install -y --no-install-recommends \
        autossh \
        openssh-client \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for the listener. UID 1000 keeps `chown` in host bind
# mounts predictable during local dev; Fargate doesn't care.
RUN useradd --uid 1000 --create-home --home-dir /home/app --shell /bin/bash app

WORKDIR /app

# Python deps — only what the listener actually imports. Intentionally
# does NOT pull the full pyproject.toml (which includes fastmcp and its
# transitive graph); the listener is a runtime process, not the MCP
# stdio server.
RUN pip install --no-cache-dir \
        "asyncpg>=0.29" \
        "httpx>=0.27" \
        "pydantic>=2.0" \
        "pydantic-settings>=2.0"

# App code + entrypoint. server/ contains everything the listener imports
# (config.py, listener.py, tools/chatbot.py — the last one for its
# refresh_chatbot_rag function that the listener delegates to).
COPY server/ ./server/
COPY deploy/entrypoint-listener.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

# Prime .ssh with the pinned Hetzner host keys captured at image build
# time. StrictHostKeyChecking=yes at runtime refuses connections that
# don't match, so rotating the VPS host key requires rebuilding the
# image — deliberate: unexpected host key changes are a MITM signal.
RUN mkdir -p /home/app/.ssh && chmod 700 /home/app/.ssh
COPY deploy/known_hosts /home/app/.ssh/known_hosts
RUN chmod 644 /home/app/.ssh/known_hosts && chown -R app:app /home/app/.ssh

RUN chown -R app:app /app

USER app

# Defaults that match the current Hetzner Beacon deployment. The
# task definition can override for staging or future migrations.
ENV SSH_TUNNEL_HOST=root@65.108.243.192 \
    SSH_TUNNEL_FORWARD=15433:127.0.0.1:15433 \
    PYTHONUNBUFFERED=1

# tini as PID 1 → clean signal handling + zombie reaping for autossh.
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
